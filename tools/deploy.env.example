# Copy to tools/deploy.env (the file is in .gitignore) and fill in.
FTP_USER=user@your-domain.com
FTP_HOST=ftp.your-host.com
FTP_PORT=21
SITE_URL=https://your-domain.com/
# A command that prints the FTP password to stdout (do not put the password in the repo):
FTP_PASSWORD_CMD='cat /path/to/password-file'
# Private directory on the server (next to public_html) and the data directory inside it:
PRIVATE_DIR=/google-ads-mcp-php
DATA_DIR=/google-ads-mcp-php/google-ads-mcp-php-data

# ---- FTPS certificate verification (on by default) ----
# 1. Default: the certificate must be valid for FTP_HOST and signed by a CA known to the system. Nothing to set.
# 2. Host with its own CA or an intermediate missing from the system store: point to a PEM file with the CA certificate.
#FTP_SSL_CA_FILE=/path/to/host-ca.pem
# 3. Host with a self-signed or hostname-mismatched certificate: pin its SHA-256 fingerprint (take it once from the hosting
#    panel or, over a trusted connection: openssl s_client -starttls ftp -connect ftp.your-host.com:21 </dev/null 2>/dev/null |
#    openssl x509 -noout -fingerprint -sha256). The deploy aborts if the server presents a different certificate.
#FTP_CERT_SHA256=AA:BB:...:FF
# 4. Last resort only (the password and code can be intercepted): FTP_SSL_VERIFY=no
#FTP_SSL_VERIFY=no
